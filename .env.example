# =====================================================================
# VARIABLES DE ENTORNO - APUStudio Frontend (Vite / Vercel)
# =====================================================================

# URL del Proyecto de Supabase (Obligatoria)
# Configura esto en Vercel -> Project Settings -> Environment Variables
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave Anónima / Pública de Supabase (Obligatoria)
# Diseñada específicamente para ser pública en el navegador con Row Level Security (RLS)
# NUNCA uses la service_role_key en el frontend.
VITE_SUPABASE_ANON_KEY=tu_clave_anon_o_publishable

# (Opcional) Clave de API de Google Gemini para procesamiento de PDFs/Excel de costos
VITE_GEMINI_API_KEY=
